{
  "name": "smoki-website",
  "version": "1.0.0",
  "description": "SMOKi Air Quality Monitoring Web Dashboard",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run start:production",
    "start:production": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:frontend": "cd frontend && npm run preview",
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "docker:up": "docker-compose -f website-docker-compose.yml up -d",
    "docker:down": "docker-compose -f website-docker-compose.yml down",
    "docker:build": "docker-compose -f website-docker-compose.yml build",
    "docker:logs": "docker-compose -f website-docker-compose.yml logs -f",
    "test": "npm run test:frontend",
    "test:frontend": "cd frontend && npm test",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "clean": "npm run clean:frontend && npm run clean:backend",
    "clean:frontend": "cd frontend && rm -rf node_modules dist",
    "clean:backend": "cd backend && find . -type d -name __pycache__ -delete"
  },
  "keywords": [
    "air-quality",
    "monitoring",
    "dashboard",
    "react",
    "fastapi",
    "postgresql"
  ],
  "author": "SMOKi Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skhartaye/SMOKI.git"
  },
  "bugs": {
    "url": "https://github.com/skhartaye/SMOKI/issues"
  },
  "homepage": "https://github.com/skhartaye/SMOKI#readme"
}