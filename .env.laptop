# Laptop Video Detection Configuration
# Copy this to .env or set environment variables

# ─── VIDEO FILE (REQUIRED) ────────────────────────────────────────────────────
# Path to your video file for processing
VIDEO_FILE=esp32/rotonda_trim.mp4

# ─── BACKEND API (REQUIRED) ───────────────────────────────────────────────────
# Backend URL for sending detection data
API_URL=https://smoki-backend-rpi.onrender.com

# ─── DEVICE IDENTIFICATION ────────────────────────────────────────────────────
DEVICE_ID=laptop_cam_001
CAMERA_LOCATION=Laptop_Video_Processing

# ─── DETECTION SETTINGS ───────────────────────────────────────────────────────
# Whether to send detection data to backend API
SEND_DETECTIONS=true

# ─── MODEL PATHS (Optional - defaults provided) ───────────────────────────────
# SMOKE_MODEL=esp32/models/yolov8n-smoke-seg.pt
# PLATE_MODEL=esp32/license-plate.pt
# VEHICLE_MODEL=esp32/vehicle-class.pt

# ─── PROCESSING SETTINGS (Optional) ───────────────────────────────────────────
# INFER_EVERY=8     # Run inference every N frames
# SEND_EVERY=30     # Send data every N frames
# SMOKE_CONF=0.25   # Smoke detection confidence threshold
# VEHICLE_CONF=0.30 # Vehicle detection confidence threshold
# PLATE_CONF=0.15   # License plate detection confidence threshold